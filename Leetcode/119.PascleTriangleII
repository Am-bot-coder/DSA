class Solution(object):
    def getRow(self, rowIndex):
        """
        :type rowIndex: int
        :rtype: List[int]
        """

        if(rowIndex==0):
            return [1]
        numRows = rowIndex+1
        dp = [[0]*i for i in range(1,numRows+1)]
        dp[0][0] = 1
        for i in range(1,numRows):
            for j in range(i+1):
                if(j==0):
                    dp[i][j] = 1
                
                elif(j==i):
                    dp[i][j] = 1
                
                else:
                    dp[i][j] = dp[i-1][j] + dp[i-1][j-1]
                


        return dp[rowIndex]
        